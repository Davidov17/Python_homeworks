   "source": [
    "import qrcode\n",
    "\n",
    "pins = [\"001\",\"002\",\"003\",\"004\",\"005\", \"006\", \"007\", \"008\", \"009\", \"010\"]\n",
    "\n",
    "for pin in pins:\n",
    "    img = qrcode.make(pin)\n",
    "    img.save(f\"student_{pin}.png\")\n",
    "\n",
    "print(\"All QR codes generated!\")"
   ],
